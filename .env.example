# Backend API (Railway). Required when VITE_USE_JWT_AUTH=true
# Example: https://your-app.up.railway.app
VITE_BACKEND_URL=

# Dual-auth switch. Leave false/unset for production (Supabase Auth).
# Set true only for local/staging JWT testing against Railway + EC2.
VITE_USE_JWT_AUTH=false

# Admin panel password (SPA login). When VITE_USE_JWT_AUTH=true, the same
# value is sent as X-Admin-Key to FastAPI admin ESG routes (must match
# backend ADMIN_API_KEY or ADMIN_PASSWORD).
VITE_ADMIN_PASSWORD=
# Optional override for the API key (defaults to VITE_ADMIN_PASSWORD)
# VITE_ADMIN_API_KEY=
